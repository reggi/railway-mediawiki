{
  "schemaVersion": 1,
  "name": "railway-iac-standards",
  "engine": {
    "package": "knitto",
    "version": "0.2.0"
  },
  "release": {
    "provider": "release-please",
    "version": "0.2.0",
    "tagFormat": "v{version}"
  },
  "conductor": {
    "update": {
      "workflow": ".github/workflows/update-template.yml",
      "refInput": "ref"
    }
  },
  "inputs": [".gitignore", "package.json"],
  "prompts": [
    {
      "path": "metadata.name",
      "type": "text",
      "message": "Package name",
      "default": "{{project.name}}",
      "required": true,
      "when": "{{#unless (eq project.name \"template-railway\")}}true{{/unless}}"
    },
    {
      "path": "metadata.description",
      "type": "text",
      "message": "Project description",
      "required": true,
      "when": "{{#unless (eq project.name \"template-railway\")}}true{{/unless}}"
    }
  ],
  "rules": [
    {
      "id": "shared-gitignore",
      "type": "file",
      "source": ".gitignore",
      "destination": ".gitignore"
    },
    {
      "id": "package-standards",
      "type": "content",
      "parser": "package-json",
      "template": "files/package.json.hbs",
      "destination": "package.json",
      "exact": [""],
      "when": "{{#unless (eq project.name \"template-railway\")}}true{{/unless}}"
    },
    {
      "id": "typescript-standards",
      "type": "file",
      "source": "tsconfig.json",
      "destination": "tsconfig.json"
    },
    {
      "id": "pull-request-quality",
      "type": "file",
      "template": "files/workflows/quality.yml.hbs",
      "destination": ".github/workflows/quality.yml"
    },
    {
      "id": "main-quality-repair",
      "type": "file",
      "template": "files/workflows/repair-quality.yml.hbs",
      "destination": ".github/workflows/repair-quality.yml"
    },
    {
      "id": "manual-template-update",
      "type": "file",
      "source": ".github/workflows/update-template.yml",
      "destination": ".github/workflows/update-template.yml"
    },
    {
      "id": "remove-railway-readme",
      "type": "delete",
      "destination": ".railway/README.md"
    },
    {
      "id": "remove-embedded-template",
      "type": "delete",
      "destination": ".knitto/**",
      "glob": true,
      "when": "{{#unless (eq project.name \"template-railway\")}}true{{/unless}}"
    }
  ]
}
