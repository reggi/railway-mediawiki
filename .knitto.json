{
  "source": {
    "type": "git",
    "url": "https://github.com/reggi/template-railway.git",
    "path": ".knitto",
    "ref": "v0.2.0"
  },
  "engine": {
    "package": "knitto",
    "version": "0.2.0"
  },
  "metadata": {
    "name": "railway-mediawiki",
    "description": "Railway infrastructure for MediaWiki"
  },
  "overrides": {
    "package-standards": {
      "/scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "package:check": "sort-package-json package.json --check",
        "package:fix": "sort-package-json package.json",
        "railway:apply": "railway config apply",
        "railway:plan": "railway config plan",
        "test": "npm run test:quality && npm run test:heading-links && npm run test:social-cards",
        "test:heading-links": "node --test site-resources/heading-links.test.mjs",
        "test:quality": "npm run format:check && npm run package:check && npm run typecheck",
        "test:social-cards": "npm --prefix social-cards ci --no-audit --no-fund && npm --prefix social-cards test",
        "test:social-cards:docker": "sh extensions/SocialCards/tests/docker.sh",
        "typecheck": "tsc --noEmit"
      }
    }
  }
}
